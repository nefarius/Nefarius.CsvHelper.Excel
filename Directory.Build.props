<Project>

  <PropertyGroup>
    <!-- Copyright information -->
    <Authors>Benjamin Höglinger-Stelzer</Authors>
    <Copyright>Copyright © Benjamin Höglinger-Stelzer 2022-2026</Copyright>

    <!-- Package Icon -->
    <PackageIcon>NSS-128x128.png</PackageIcon>
    <PackageIconUrl />
    <PackageReadmeFile>README.md</PackageReadmeFile>

    <!-- Common solution settings -->
    <RepositoryRoot>$(MSBuildThisFileDirectory)</RepositoryRoot>
    <OutputPath>$(RepositoryRoot)bin\$(MSBuildProjectName)\$(Configuration)\</OutputPath>
    <LangVersion>latest</LangVersion>
    <ContinuousIntegrationBuild Condition="'$(CI)' == 'true'">true</ContinuousIntegrationBuild>

    <!-- Docs and symbols generation -->
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IncludeSymbols>true</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
  </PropertyGroup>

  <ItemGroup>
    <None Include="$(RepositoryRoot)assets\NSS-128x128.png" Pack="true" PackagePath="\" />
    <None Include="$(RepositoryRoot)README.md" Pack="true" PackagePath="\" />
  </ItemGroup>
</Project>
