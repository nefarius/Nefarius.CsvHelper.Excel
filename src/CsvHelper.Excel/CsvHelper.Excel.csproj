<Project Sdk="Microsoft.NET.Sdk">
    <PropertyGroup>
        <Description>Read and write Excel workbooks with CsvHelper record mapping and ClosedXML. Forked from CsvHelper.Excel by Chris Young.</Description>
        <AssemblyTitle>CsvHelper for Excel</AssemblyTitle>
        <Authors>Joost Meulenkamp, Chris Young, hurles, Nefarius</Authors>
        <TargetFrameworks>netstandard2.0;netstandard2.1</TargetFrameworks>
        <!-- CI tests each asset explicitly, including its transitive dependencies. -->
        <TargetFrameworks Condition="'$(LibraryTargetFramework)' != ''">$(LibraryTargetFramework)</TargetFrameworks>
        <OutputType>Library</OutputType>
        
        <PackageId>Nefarius.CsvHelper.Excel</PackageId>
        <AssemblyName>Nefarius.CsvHelper.Excel</AssemblyName>
        <RootNamespace>Nefarius.CsvHelper.Excel</RootNamespace>
        
        <PackageTags>CSV;CSVHelper;Excel;ClosedXML</PackageTags>
        <PackageProjectUrl>https://github.com/nefarius/Nefarius.CsvHelper.Excel</PackageProjectUrl>
        <PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
    </PropertyGroup>

    <PropertyGroup>
        <MinVerTagPrefix>v</MinVerTagPrefix>
        <MinVerMinimumMajorMinor>34.0</MinVerMinimumMajorMinor>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="ClosedXML" Version="0.105.1" />
        <!-- Record mapping requires CsvHelper's source generator in consuming projects. -->
        <PackageReference Include="CsvHelper" Version="34.0.0" PrivateAssets="none" />
        <!-- v11 no longer supports .NET 8 consumers. Keep the latest compatible servicing line. -->
        <PackageReference Include="Microsoft.Bcl.AsyncInterfaces" Version="10.0.15" Condition="'$(TargetFramework)' == 'netstandard2.0'" />
        <PackageReference Include="MinVer" Version="8.0.0">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>
</Project>
